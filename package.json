{
  "name": "context-tools",
  "displayName": "ConTeXt Tools",
  "description": "ConTeXt SyncTeX PDF preview, DigestiF language server, TextMate grammar, and snippets",
  "version": "0.1.33",
  "publisher": "context-lab",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/conradolandia/context-lab.git"
  },
  "bugs": {
    "url": "https://github.com/conradolandia/context-lab/issues"
  },
  "homepage": "https://github.com/conradolandia/context-lab#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:tex"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "languages": [
      {
        "id": "context",
        "aliases": [
          "ConTeXt"
        ],
        "extensions": [
          ".mkiv",
          ".mkxl",
          ".mkvi",
          ".mklx",
          ".mkii"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "context",
        "scopeName": "text.tex.context",
        "path": "./syntaxes/context.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.lua": "lua",
          "meta.embedded.inline.lua": "lua",
          "meta.embedded.block.xml": "xml"
        },
        "tokenTypes": {
          "string.unquoted.value.context": "other"
        },
        "unbalancedBracketScopes": [
          "markup.inline.raw.context",
          "markup.raw.block.context"
        ]
      }
    ],
    "snippets": [
      {
        "language": "context",
        "path": "./snippets/context.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "context-lab",
          "title": "ConTeXt",
          "icon": "media/context-activity.svg"
        }
      ]
    },
    "views": {
      "context-lab": [
        {
          "id": "context.projectView",
          "name": "Project",
          "contextualTitle": "ConTeXt Project",
          "icon": "$(list-tree)"
        }
      ]
    },
    "commands": [
      {
        "command": "context.buildAndPreview",
        "title": "ConTeXt: Build and Preview"
      },
      {
        "command": "context.forwardSyncTeX",
        "title": "ConTeXt: Forward SyncTeX"
      },
      {
        "command": "context.showPdf",
        "title": "ConTeXt: Show PDF"
      },
      {
        "command": "context.pickRootFile",
        "title": "ConTeXt: Set Main (Root) File"
      },
      {
        "command": "context.projectView.refresh",
        "title": "ConTeXt: Refresh Project View",
        "icon": "$(refresh)"
      },
      {
        "command": "context.projectView.revealActive",
        "title": "ConTeXt: Reveal Active File in Project View",
        "icon": "$(target)"
      },
      {
        "command": "context.projectView.buildNode",
        "title": "Build",
        "icon": "$(play)"
      },
      {
        "command": "context.projectView.forwardSyncNode",
        "title": "Forward SyncTeX",
        "icon": "$(eye)"
      },
      {
        "command": "context.projectView.setRootFromNode",
        "title": "Set as Main (Root) File"
      },
      {
        "command": "context.refreshKeywords",
        "title": "ConTeXt: Refresh command keywords"
      },
      {
        "command": "context.projectManager.create",
        "title": "ConTeXt: New Document Structure…",
        "icon": "$(new-file)"
      },
      {
        "command": "context.projectManager.upgrade",
        "title": "ConTeXt: Upgrade Document Structure…"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "context.projectManager.create",
          "when": "view == context.projectView",
          "group": "navigation@0"
        },
        {
          "command": "context.projectView.revealActive",
          "when": "view == context.projectView",
          "group": "navigation@1"
        },
        {
          "command": "context.projectView.refresh",
          "when": "view == context.projectView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "context.projectView.buildNode",
          "when": "view == context.projectView && viewItem =~ /context\\.projectNode\\.(product|component|document)/",
          "group": "inline@1"
        },
        {
          "command": "context.projectView.forwardSyncNode",
          "when": "view == context.projectView && viewItem =~ /context\\.projectNode\\.(product|component|document|environment|input)/",
          "group": "inline@2"
        },
        {
          "command": "context.projectView.buildNode",
          "when": "view == context.projectView && viewItem =~ /context\\.projectNode\\.(product|component|document|project)/",
          "group": "context@1"
        },
        {
          "command": "context.projectView.forwardSyncNode",
          "when": "view == context.projectView && viewItem =~ /context\\.projectNode\\.(product|component|document|environment|input)/",
          "group": "context@2"
        },
        {
          "command": "context.projectView.setRootFromNode",
          "when": "view == context.projectView && viewItem =~ /context\\.projectNode\\.(product|component|document|project)/",
          "group": "context@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "context.forwardSyncTeX",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "ConTeXt Tools",
      "properties": {
        "context.root": {
          "type": "string",
          "default": "",
          "description": "ConTeXt installation root (Standalone / LMTX tree): the directory that contains tex/ (for example $HOME/context or /opt/context). Binaries live under tex/texmf-<platform>/bin/. Empty = use PATH and infer the install root."
        },
        "context.contextPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the context executable. Overrides root/PATH when set."
        },
        "context.mtxrunPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the mtxrun executable. Overrides root/PATH when set."
        },
        "context.rootFile": {
          "type": "string",
          "default": "",
          "description": "Main ConTeXt file to compile (workspace-relative or absolute). Empty = auto-detect via % !TEX root, \\startcomponent->\\product, or the active file."
        },
        "context.projectManager.defaultExtension": {
          "type": "string",
          "default": ".tex",
          "enum": [".tex"],
          "description": "File extension for Project Manager scaffolds. v1 writes .tex only."
        },
        "context.projectManager.usePrefixedNames": {
          "type": "boolean",
          "default": false,
          "description": "When true, Project Manager uses denser prefixes (product_*, component_*). Default matches wiki §4/§5 names (env_*/project_* only)."
        },
        "context.projectManager.setRootFileOnCreate": {
          "type": "boolean",
          "default": true,
          "description": "When true, after creating a structure set context.rootFile to the compile root (document or product). Does not write % !TEX root into files."
        },
        "context.projectView.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the ConTeXt Project TreeView in the ConTeXt activity-bar container."
        },
        "context.projectView.includeInputs": {
          "type": "boolean",
          "default": false,
          "description": "When true, show \\input children under products in the Project view."
        },
        "context.projectView.includeModules": {
          "type": "boolean",
          "default": false,
          "description": "Reserved. \\usemodule / \\externalfigure are not shown in the Project tree (document links cover them)."
        },
        "context.projectView.maxFiles": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Stop expanding the project graph after this many files; remaining includes are truncated."
        },
        "context.projectView.refreshDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Debounce interval (ms) before rescanning the project graph after edits or saves."
        },
        "context.build.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended after --synctex=repeat when building."
        },
        "context.build.onSave": {
          "type": "boolean",
          "default": false,
          "description": "When true, save of a ConTeXt/TeX file starts a build. While a build runs, further saves queue one follow-up build (rapid saves coalesce)."
        },
        "context.synctex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SyncTeX forward and backward navigation."
        },
        "context.debugOutput": {
          "type": "boolean",
          "default": false,
          "description": "When true, write verbose internal traces (viewer, artifact gate, SyncTeX dumps, project scan timing) to the ConTeXt debug output channel. Build and user-facing messages stay on ConTeXt."
        },
        "context.digestif.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the Digestif language server for ConTeXt/TeX completion and hover. Build and SyncTeX keep working if Digestif is missing."
        },
        "context.digestifPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Digestif executable. Empty = resolve ~/.luarocks/bin/digestif then digestif on PATH."
        },
        "context.texAssociation.dontAsk": {
          "type": "boolean",
          "default": false,
          "description": "If true, never prompt to associate *.tex with the ConTeXt language for DigestiF. Also set via the prompt's Don't ask again action (workspace state)."
        },
        "context.latexWorkshopConflict.dontAsk": {
          "type": "boolean",
          "default": false,
          "description": "If true, never warn when LaTeX Workshop (James-Yu.latex-workshop) is enabled and also contributes language id context. Also set via the warning's Don't show again action (global state)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "generate:keywords": "node scripts/generate-context-keywords.mjs",
    "test": "npm run compile && node --test dist/test/**/*.test.js && npm run test:grammar",
    "test:grammar": "vscode-tmgrammar-test -g src/test/grammar/stubs/lua.tmLanguage.json -g src/test/grammar/stubs/xml.tmLanguage.json \"src/test/grammar/*.test.mkiv\" && vscode-tmgrammar-snap -g src/test/grammar/stubs/lua.tmLanguage.json -g src/test/grammar/stubs/xml.tmLanguage.json \"src/test/grammar/snap/*.mkiv\"",
    "handshake:context": "node scripts/digestif-context-handshake.mjs",
    "lint": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "vscode-languageclient": "^9.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
