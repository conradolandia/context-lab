{
  "comments": {
    "lineComment": "%"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "`", "close": "'" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["`", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:\\\\start[a-zA-Z]+(?!.*\\\\stop[a-zA-Z])|%\\s*#?region\\b)",
      "end": "^\\s*(?:\\\\stop[a-zA-Z]+|%\\s*#?endregion\\b)"
    }
  }
}
